---
import { site } from '../data/site';
import { versao } from '../data/versao';

interface Props {
  titulo?: string;
  descricao?: string;
}

const { titulo, descricao = site.descricao } = Astro.props;
const tituloCompleto = titulo ? `${titulo} · ${site.nome}` : `${site.nome} · Portfólio`;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(`${base}og.png`, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`${base}favicon.png`} type="image/png" />
    <link rel="apple-touch-icon" href={`${base}avatar-viking.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&family=Noto+Sans+Runic&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      try {
        const t = localStorage.getItem('tema');
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <header class="topo">
      <div class="container topo-inner">
        <a href={base} class="marca"><span class="marca-sigla runa">ᛃ</span><span class="humano">{site.nome}</span></a>
        <nav>
          <a href={`${base}#projetos`}>projetos</a>
          <a class="so-largo" href={`${base}#linha`}>trajetória</a>
          <a class="so-largo" href={`${base}#metodo`}>método</a>
          <a href={`${base}curriculo/`}>currículo</a>
          <a href={`${base}#contato`}>contato</a>
          <button class="tema" type="button" aria-label="Alternar tema claro/escuro" data-tema-toggle>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="rodape">
      <div class="container rodape-inner">
        <span class="humano">feito à mão, com uma tripulação de agentes · {new Date().getFullYear()}</span>
        <span class="maquina rodape-links">
          {site.linkedin && <a href={site.linkedin} target="_blank" rel="noopener">linkedin</a>}
          <a href={site.github} target="_blank" rel="noopener">github</a>
          <a href={`${base}julien-crouzillard-curriculo.pdf`} download>currículo (pdf)</a>
          <span class="versao" title="versão publicada do site">
            <span class="runa" aria-hidden="true">ᚱ</span> {versao.nome}{versao.hash && (
              <> · <a href={versao.url} target="_blank" rel="noopener">{versao.hash}</a></>
            )}
          </span>
        </span>
      </div>
    </footer>

    <script is:inline>
      document.querySelector('[data-tema-toggle]')?.addEventListener('click', () => {
        const el = document.documentElement;
        const escuro =
          el.dataset.theme === 'dark' ||
          (!el.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
        el.dataset.theme = escuro ? 'light' : 'dark';
        try { localStorage.setItem('tema', el.dataset.theme); } catch {}
      });
      const io = new IntersectionObserver(
        (es) => es.forEach((e) => e.isIntersecting && (e.target.classList.add('visivel'), io.unobserve(e.target))),
        { threshold: 0.12 }
      );
      document.querySelectorAll('.revelar').forEach((el) => io.observe(el));

      // números que contam ao entrar na tela (mantém sufixos como "+" e zeros à esquerda)
      const reduz = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const ioNum = new IntersectionObserver((es) => es.forEach((e) => {
        if (!e.isIntersecting) return; ioNum.unobserve(e.target);
        const el = e.target, alvo = el.textContent.trim(), m = alvo.match(/^(\D*)(\d+)(.*)$/);
        if (!m || reduz) return;
        const [, pre, num, pos] = m, fim = +num, largura = num.length, t0 = performance.now(), dur = 1100;
        const passo = (t) => {
          const k = Math.min(1, (t - t0) / dur), v = Math.round(fim * (1 - Math.pow(1 - k, 3)));
          el.textContent = pre + String(v).padStart(largura, '0') + pos;
          if (k < 1) requestAnimationFrame(passo);
        };
        requestAnimationFrame(passo);
      }), { threshold: 0.6 });
      document.querySelectorAll('[data-contar] dt').forEach((el) => ioNum.observe(el));
    </script>
    {import.meta.env.PROD && site.goatcounter && (
      <script
        is:inline
        async
        data-goatcounter={`https://${site.goatcounter}.goatcounter.com/count`}
        src="https://gc.zgo.at/count.js"
      ></script>
    )}
  </body>
</html>

<style is:global>
  /* ── Duas vozes ───────────────────────────────────────────────
     .humano  → Instrument Serif itálico: o que é dito por uma pessoa
     .maquina → JetBrains Mono: o que o sistema registra, mede, decide
     ───────────────────────────────────────────────────────────── */
  :root {
    --bg: #ece3d2;        /* osso / pergaminho */
    --bg-2: #f5efe3;
    --bg-3: #e0d5c0;
    --linha: #cfc2a8;     /* pauta do pergaminho */
    --texto: #171412;
    --texto-2: #52483d;
    --texto-3: #86796a;
    --vermelho: #b8322a;  /* sangue e moletom */
    --vermelho-2: #8f2620;
    --ouro: #9a7a2e;      /* bronze envelhecido */
    --tinta: #171412;     /* carimbo */
    --mix: 70%;
    --sombra: 0 1px 2px rgb(27 22 18 / 0.06), 0 10px 30px rgb(27 22 18 / 0.08);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      --bg: #0f0e0c;      /* ferro à noite */
      --bg-2: #181512;
      --bg-3: #221e19;
      --linha: #2e2822;
      --texto: #ece3d2;
      --texto-2: #b4a899;
      --texto-3: #7a6f64;
      --vermelho: #e0493c;
      --ouro: #c9a24a;
      --vermelho-2: #d4483c;
      --tinta: #e0493c;
      --mix: 100%;
      --sombra: 0 1px 2px rgb(0 0 0 / 0.4), 0 14px 36px rgb(0 0 0 / 0.45);
    }
  }
  :root[data-theme='dark'] {
    --bg: #0f0e0c;
    --bg-2: #181512;
    --bg-3: #221e19;
    --linha: #2e2822;
    --texto: #ece3d2;
    --texto-2: #b4a899;
    --texto-3: #7a6f64;
    --vermelho: #e0493c;
    --ouro: #c9a24a;
    --vermelho-2: #d4483c;
    --tinta: #e0493c;
    --mix: 100%;
    --sombra: 0 1px 2px rgb(0 0 0 / 0.4), 0 14px 36px rgb(0 0 0 / 0.45);
  }
  /* aliases usados pelos componentes */
  :root { --borda: var(--linha); --acento: var(--vermelho); --humano: var(--vermelho); }

  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--texto);
    font: 400 16px/1.65 Inter, system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }
  h1, h2, h3 { font-family: 'Instrument Serif', Georgia, serif; font-weight: 400; line-height: 1.05; letter-spacing: -0.015em; margin: 0; }
  a { color: inherit; }
  img { max-width: 100%; height: auto; display: block; }

  .humano { font-family: 'Instrument Serif', Georgia, serif; font-style: italic; font-weight: 400; }
  .maquina, .mono, .rotulo {
    font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 0.78rem;
  }
  .rotulo { letter-spacing: 0.1em; text-transform: uppercase; color: var(--texto-3); }
  .rotulo b { color: var(--vermelho); font-weight: 500; }
  .runa { font-family: 'Noto Sans Runic', serif; color: var(--ouro); font-size: 1.05em; }
  /* divisor em nó nórdico: trama contínua, como a borda de uma pedra rúnica */
  .no-nordico { height: 14px; margin: 0; border: 0; background:
    repeating-linear-gradient(135deg, var(--ouro) 0 1px, transparent 1px 8px),
    repeating-linear-gradient(45deg, var(--ouro) 0 1px, transparent 1px 8px); opacity: .55; }

  .container { width: min(1120px, 100% - 32px); margin-inline: auto; }
  section { padding-block: clamp(56px, 9vw, 112px); }
  .secao-titulo { font-size: clamp(2.2rem, 5vw, 3.4rem); margin: 10px 0 16px; }
  .secao-titulo em { font-style: italic; color: var(--vermelho); }
  .secao-sub { color: var(--texto-2); max-width: 640px; margin: 0 0 40px; font-size: 1.05rem; }

  /* papel pautado: linhas finas horizontais como caderno de spec */
  .papel {
    background-image: repeating-linear-gradient(to bottom, transparent 0 31px, color-mix(in srgb, var(--linha) 55%, transparent) 31px 32px);
  }

  .revelar { opacity: 0; transform: translateY(18px); transition: opacity 0.7s ease, transform 0.7s cubic-bezier(.2,.8,.2,1); }
  .revelar.visivel { opacity: 1; transform: none; }

  /* ── movimento ─────────────────────────────────────────────── */
  @keyframes subir { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: none; } }
  @keyframes carimbar {
    0%   { opacity: 0; transform: rotate(var(--rot, -6deg)) scale(1.8); }
    60%  { opacity: 1; transform: rotate(var(--rot, -6deg)) scale(.94); }
    100% { opacity: .92; transform: rotate(var(--rot, -6deg)) scale(1); }
  }
  @keyframes voar { 0%, 100% { transform: translate(0, 0) rotate(-10deg); } 50% { transform: translate(6px, -10px) rotate(-4deg); } }
  @keyframes voar-espelho { 0%, 100% { transform: scaleX(-1) translate(0, 0) rotate(-6deg); } 50% { transform: scaleX(-1) translate(6px, -8px) rotate(0deg); } }
  @keyframes girar { to { transform: rotate(360deg); } }
  @keyframes brilho { to { background-position: 400px 0, -400px 0; } }
  @keyframes pulsar { 0%, 100% { box-shadow: 0 0 0 5px color-mix(in srgb, var(--vermelho) 22%, transparent); } 50% { box-shadow: 0 0 0 9px color-mix(in srgb, var(--vermelho) 8%, transparent); } }

  .entrar { animation: subir .8s cubic-bezier(.2,.8,.2,1) both; animation-delay: var(--d, 0s); }
  .carimbo { animation: carimbar .5s cubic-bezier(.2,1.4,.4,1) both; animation-delay: var(--d, .9s); }
  .revelar .carimbo { animation-play-state: paused; }
  .revelar.visivel .carimbo { animation-play-state: running; animation-delay: .35s; }
  .no-nordico { animation: brilho 14s linear infinite; }

  @media (prefers-reduced-motion: reduce) {
    .revelar { opacity: 1; transform: none; transition: none; }
    .entrar, .carimbo, .no-nordico, .corvo, .anel { animation: none !important; }
    html { scroll-behavior: auto; }
  }

  .topo {
    position: sticky; top: 0; z-index: 10;
    backdrop-filter: blur(12px);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    border-bottom: 1px solid var(--linha);
  }
  .topo-inner { display: flex; align-items: center; justify-content: space-between; height: 60px; gap: 16px; }
  .marca { display: flex; align-items: center; gap: 10px; text-decoration: none; white-space: nowrap; font-size: 1.25rem; }
  .marca-sigla {
    display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%;
    background: var(--vermelho); color: #fff; font-size: 1rem; color: #fff;
  }
  .topo nav { display: flex; align-items: center; gap: 22px; }
  .topo nav a { text-decoration: none; color: var(--texto-2); font: 400 0.78rem 'JetBrains Mono', monospace; }
  .topo nav a:hover { color: var(--vermelho); }
  .tema {
    display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%;
    border: 1px solid var(--linha); background: var(--bg-2); color: var(--texto-2); cursor: pointer;
  }
  /* no celular ficam só os três destinos que o recrutador procura: projetos, currículo e contato */
  @media (max-width: 720px) { .topo nav { gap: 14px; } .topo nav a.so-largo { display: none; } }
  @media (max-width: 480px) { .marca .humano { display: none; } }

  .rodape { border-top: 1px solid var(--linha); padding-block: 28px; color: var(--texto-3); }
  .rodape-inner { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; }
  .rodape .humano { font-size: 1.05rem; }
  .rodape-links { display: flex; gap: 16px; flex-wrap: wrap; }
  .rodape-links a { color: var(--texto-2); }
  .rodape-links a:hover { color: var(--vermelho); }
  .rodape .versao { color: var(--texto-3); }
  .rodape .versao a { color: var(--texto-3); text-decoration-style: dotted; }

  .selo {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 4px 10px; border-radius: 4px; border: 1px solid var(--linha);
    font: 500 0.7rem 'JetBrains Mono', monospace; color: var(--texto-2); background: var(--bg-2);
    white-space: nowrap; text-decoration: none;
  }
  .chip {
    display: inline-block; padding: 4px 9px; border-radius: 4px; border: 1px solid var(--linha);
    background: var(--bg-2); color: var(--texto-2); font: 400 0.74rem 'JetBrains Mono', monospace;
  }
  .botao {
    display: inline-flex; align-items: center; gap: 8px; padding: 12px 20px; border-radius: 6px;
    border: 1px solid var(--texto); background: transparent; text-decoration: none;
    font: 500 0.82rem 'JetBrains Mono', monospace; color: var(--texto);
  }
  .botao.primario { background: var(--vermelho); color: #fff; border-color: var(--vermelho); }
  .botao:hover { transform: translateY(-1px); }
</style>
