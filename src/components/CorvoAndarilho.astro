---
// Huginn de passagem: de vez em quando o corvo pousa num canto vazio da página,
// dá uns pulinhos, bica o chão e vai embora. Clicar nele abre o chat.
---

<button class="andarilho" type="button" tabindex="-1" aria-label="Huginn, o corvo: clique para conversar" hidden data-andarilho>
  <span class="andarilho-corpo">
    <svg viewBox="0 0 64 48" width="44" height="33" aria-hidden="true">
      <g class="andarilho-pernas" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" fill="none">
        <path d="M33 34l-2 9m0 0h-3m3 0h3" /><path d="M38 34l1 9m0 0h-3m3 0h3" />
      </g>
      <path d="M4 27l15-3 2 7Z" fill="currentColor" />
      <path d="M16 27c4-8 16-10 24-8 4-4 10-6 14-3l7 2.5-7 2.5c0 6-6 12-16 13-8 1-16-1-22-7Z" fill="currentColor" />
      <g class="andarilho-asa"><path d="M22 25c6-4 14-5 21-2-5 6-13 8-21 2Z" fill="currentColor" stroke="var(--bg)" stroke-width=".8" /></g>
      <circle cx="51" cy="17.6" r="1.5" fill="#c9a24a" />
    </svg>
  </span>
</button>

<script>
  const corvo = document.querySelector<HTMLButtonElement>('[data-andarilho]');
  const reduz = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (corvo && !reduz) {
    const corpo = corvo.querySelector<HTMLElement>('.andarilho-corpo')!;
    const celular = matchMedia('(max-width: 640px)').matches;
    const LARGURA = celular ? 36 : 44;
    const ALTURA = celular ? 27 : 33;
    const sorteio = (min: number, max: number) => min + Math.random() * (max - min);
    const esperar = (ms: number) => new Promise((ok) => setTimeout(ok, ms));
    // o que estiver nestes elementos é conteúdo: o corvo nunca pousa em cima
    const CONTEUDO = 'p,h1,h2,h3,h4,h5,h6,a,button,input,textarea,label,img,svg,picture,video,li,dt,dd,code,pre,table,figure,blockquote,header,nav,.chip,[data-corvo-chat]';

    // um ponto é vazio se o que está embaixo dele é só fundo, sem texto solto
    function vazio(x: number, y: number): boolean {
      const el = document.elementFromPoint(x, y);
      if (!el || el.closest(CONTEUDO)) return false;
      return ![...el.childNodes].some((n) => n.nodeType === Node.TEXT_NODE && n.textContent!.trim());
    }

    // procura um lugar vazio visível na tela, com folga em volta do corvo
    function lugarVazio(): { x: number; y: number } | null {
      const w = innerWidth, h = innerHeight;
      for (let tentativa = 0; tentativa < 40; tentativa++) {
        const x = sorteio(12, w - LARGURA - 12);
        const y = sorteio(h * 0.22, h - ALTURA - 24);
        const pontos = [[-14, -10], [LARGURA / 2, -10], [LARGURA + 14, -10], [-14, ALTURA / 2], [LARGURA / 2, ALTURA / 2], [LARGURA + 14, ALTURA / 2], [-14, ALTURA + 6], [LARGURA / 2, ALTURA + 6], [LARGURA + 14, ALTURA + 6]];
        if (pontos.every(([dx, dy]) => vazio(x + dx, y + dy))) return { x, y };
      }
      return null;
    }

    let lado = 1;
    function olharPara(direita: boolean) { lado = direita ? 1 : -1; corpo.style.setProperty('--lado', String(lado)); }

    function voar(de: [number, number], para: [number, number], ms: number) {
      corvo!.classList.add('voando');
      const a = corvo!.animate(
        [{ transform: `translate(${de[0]}px, ${de[1]}px)` }, { transform: `translate(${(de[0] + para[0]) / 2}px, ${Math.min(de[1], para[1]) - 40}px)`, offset: 0.55 }, { transform: `translate(${para[0]}px, ${para[1]}px)` }],
        { duration: ms, easing: 'ease-in-out', fill: 'forwards' },
      );
      return a.finished.then(() => corvo!.classList.remove('voando'));
    }

    async function pulinho(dx: number) {
      olharPara(dx > 0);
      const atual = new DOMMatrix(getComputedStyle(corvo!).transform).m41;
      await corvo!.animate(
        [{ transform: `translate(${atual}px, 0)` }, { transform: `translate(${atual + dx / 2}px, -9px)` }, { transform: `translate(${atual + dx}px, 0)` }],
        { duration: 260, easing: 'ease-out', fill: 'forwards' },
      ).finished;
    }

    async function bicar() {
      await corpo.animate(
        [{ rotate: '0deg' }, { rotate: `${lado * 28}deg` }, { rotate: `${lado * 22}deg`, offset: 0.6 }, { rotate: '0deg' }],
        { duration: 420, easing: 'ease-in-out' },
      ).finished;
    }

    let ocupado = false;
    async function visitar() {
      if (ocupado || document.hidden || document.querySelector('[data-corvo-chat].aberto')) return;
      const lugar = lugarVazio();
      if (!lugar) return;
      ocupado = true;
      // posição na página, não na tela: se o visitante rolar, o corvo fica onde pousou
      corvo!.style.left = `${lugar.x + scrollX}px`;
      corvo!.style.top = `${lugar.y + scrollY}px`;
      corvo!.hidden = false;
      const daEsquerda = lugar.x > innerWidth / 2 ? false : true;
      const entrada: [number, number] = [daEsquerda ? -lugar.x - 80 : innerWidth - lugar.x + 40, -lugar.y - 60];
      olharPara(daEsquerda);
      try {
        await voar(entrada, [0, 0], 1500);
        let x = 0;
        const acoes = Math.round(sorteio(3, 6));
        for (let i = 0; i < acoes; i++) {
          await esperar(sorteio(350, 900));
          if (Math.random() < 0.55) {
            // pulinhos curtos, sem sair do pedaço vazio que ele escolheu
            const dx = (Math.random() < 0.5 ? -1 : 1) * sorteio(10, 18);
            if (Math.abs(x + dx) > 26) continue;
            x += dx;
            await pulinho(dx);
          } else {
            await bicar();
            if (Math.random() < 0.3) await bicar();
          }
        }
        await esperar(sorteio(500, 1100));
        const paraDireita = Math.random() < 0.5;
        olharPara(paraDireita);
        await voar([x, 0], [paraDireita ? innerWidth - lugar.x + 60 : -lugar.x - 90, -lugar.y - 80], 1400);
      } finally {
        corvo!.hidden = true;
        corvo!.getAnimations().forEach((a) => a.cancel());
        ocupado = false;
      }
    }

    corvo.addEventListener('click', () => {
      document.querySelector<HTMLButtonElement>('[data-corvo-abrir]')?.click();
      corvo.hidden = true;
    });

    // aparece pouco: a primeira visita depois de uns segundos, depois a cada 40 a 90 s (no celular, mais espaçado)
    const fator = celular ? 1.6 : 1;
    const agendar = (min: number, max: number) => setTimeout(async () => { await visitar(); agendar(40_000 * fator, 90_000 * fator); }, sorteio(min, max));
    agendar(9_000, 16_000);
  }
</script>

<style>
  .andarilho {
    position: absolute; z-index: 40; left: 0; top: 0; padding: 0; border: 0; background: none;
    color: var(--texto); cursor: pointer; line-height: 0; -webkit-tap-highlight-color: transparent;
  }
  .andarilho[hidden] { display: none; }
  .andarilho:hover { color: var(--vermelho); }
  .andarilho-corpo { display: block; transform: scaleX(var(--lado, 1)); transform-origin: 50% 90%; }
  .andarilho-asa { transform-origin: 30px 24px; transform-box: view-box; }
  .voando .andarilho-asa { animation: andarilho-bater .22s ease-in-out infinite alternate; }
  .voando .andarilho-pernas { opacity: 0; }
  @keyframes andarilho-bater { from { transform: rotate(18deg); } to { transform: rotate(-62deg) translateY(-2px); } }
  @media (max-width: 640px) { .andarilho svg { width: 36px; height: 27px; } }
</style>
